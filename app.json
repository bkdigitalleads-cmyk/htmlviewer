{
  "expo": {
    "name": "HTML Viewer",
    "slug": "htmlviewer",
    "scheme": "htmlviewer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6F3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bwk.htmlviewer",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.developer-tools",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Web page",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          },
          {
            "CFBundleTypeName": "Code or text file",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text",
              "public.css",
              "com.netscape.javascript-source",
              "public.json",
              "public.xml",
              "public.svg-image",
              "net.daringfireball.markdown"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "public.xhtml",
            "UTTypeDescription": "XHTML page",
            "UTTypeConformsTo": [
              "public.xml",
              "public.html"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "xhtml",
                "xht"
              ],
              "public.mime-type": [
                "application/xhtml+xml"
              ]
            }
          },
          {
            "UTTypeIdentifier": "public.css",
            "UTTypeDescription": "CSS style sheet",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "css"
              ],
              "public.mime-type": [
                "text/css"
              ]
            }
          },
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown text",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown"
              ],
              "public.mime-type": [
                "text/markdown"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.bwk.htmlviewer",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B6E66",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-localization",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F2",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121314"
          }
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "extra": {
      "revenueCatApiKeyIos": "TODO_COWORK_REVENUECAT_PUBLIC_IOS_KEY",
      "eas": {
        "projectId": "TODO_COWORK_EAS_PROJECT_ID"
      }
    },
    "owner": "bkdeveloper123"
  }
}
